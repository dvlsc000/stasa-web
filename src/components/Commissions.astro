---
import Stitch from './Stitch.astro';
import Signature from './Signature.astro';
import { t, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { ui } = t(lang);
const types: string[] = ui('form.types');
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---
<section class="commissions" id="commissions" aria-labelledby="comm-title">
  <div class="commissions__text">
    <h2 id="comm-title">{ui('comm.title')}</h2>
    <p>{ui('comm.p')}</p>
  </div>

  <div class="commissions__cloth pat-gingham cut-2">
    <form class="form" method="post" action={endpoint || undefined} data-endpoint={endpoint} novalidate
      data-msg-required={ui('form.required')} data-msg-email={ui('form.invalidEmail')}
      data-msg-sending={ui('form.sending')} data-msg-sent={ui('form.sent')} data-msg-error={ui('form.error')}
      data-about={ui('form.about')}>
      <div class="field cut-1 tilt-c">
        <label for="f-name" class="label">{ui('form.name')}</label>
        <input id="f-name" name="name" autocomplete="name" required />
        <p class="field__err label" id="f-name-err" aria-live="polite"></p>
        <Stitch cut={1} />
      </div>
      <div class="field cut-3 tilt-b">
        <label for="f-email" class="label">{ui('form.email')}</label>
        <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required />
        <p class="field__err label" id="f-email-err" aria-live="polite"></p>
        <Stitch cut={3} />
      </div>
      <div class="field cut-5 tilt-e">
        <label for="f-type" class="label">{ui('form.type')}</label>
        <select id="f-type" name="type">
          {types.map((o, i) => <option value={['bespoke','buy','stage','press','other'][i]}>{o}</option>)}
        </select>
        <Stitch cut={5} />
      </div>
      <div class="field field--msg cut-6 tilt-c">
        <label for="f-msg" class="label">{ui('form.message')}</label>
        <textarea id="f-msg" name="message" rows="5" placeholder={ui('form.messageHint')} required></textarea>
        <p class="field__err label" id="f-msg-err" aria-live="polite"></p>
        <Stitch cut={6} />
      </div>
      <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="form__foot">
        <button class="patch form__submit" type="submit">
          <span class="form__submit-label">{ui('form.submit')}</span>
          <svg class="stitch stitch--light form__sew" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polygon pathLength="1" points="3,10 34,5 71,8 97,6 96,52 97,90 64,93 27,91 4,93 5,47" /></svg>
        </button>
        <p class="form__status label" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>

  <div class="commissions__sign">
    <Signature title="Staša Čimbur" />
  </div>
</section>
