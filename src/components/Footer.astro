---
import LangSwitch from './LangSwitch.astro';
import Stitch from './Stitch.astro';
import { t, site, type Lang } from '../lib/content';
interface Props { lang: Lang; path?: string }
const { lang, path = '' } = Astro.props;
const { ui } = t(lang);
---
<footer class="footer pat-dots-ink">
  <div class="footer__panel on-ink cut-4">
    <LangSwitch lang={lang} path={path} label={`${ui('a11y.langSwitch')} — ${site.label}`} />
    <a class="footer__link" href={site.instagram} rel="me noopener"><svg aria-hidden="true"><use href="#i-instagram" /></svg>{ui('footer.instagram')}</a>
    <a class="footer__link" href={`mailto:${site.email}`}>{site.email}</a>
    <p class="label">© {new Date().getFullYear()} {site.label} · Staša Čimbur. {ui('footer.rights')}</p>
    <Stitch cut={4} light />
  </div>
</footer>
