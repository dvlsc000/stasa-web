---
import Art from './Art.astro';
import Stitch from './Stitch.astro';
import Thread from './Thread.astro';
import { t, works, site, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { ui, work } = t(lang);
const pieces = site.heroCutouts.map((id) => works.find((w) => w.id === id)!).filter(Boolean);
// depth (z, px) and placement for each landing layer; the first is the hero image
const slots = ['h-a', 'h-b', 'h-c', 'h-d', 'h-e'];
const z = [150, 60, -60, 220, 110];
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__pin">
    <div class="hero__stage" data-stage>
      <div class="hero__wall pat-wallpaper-ink layer" data-z="-280"></div>
      <div class="hero__floor layer" data-z="-140"><div class="hero__hem"></div></div>

      <div class="hero__pieces">
        {pieces.map((w, i) => (
          <a class:list={['hero__piece', 'layer', slots[i]]} data-z={z[i]} href={`/${lang}/work/${w.slug}/`} data-plate={w.slug}
             data-cursor="view" aria-label={`${ui('a11y.openPlate')} ${work(w.id).title}`}>
            <span class="hero__piece-inner">
              <Art work={w} alt="" mode="cutout" eager={i === 0} sizes="(max-width: 767px) 50vw, 30vw" />
            </span>
          </a>
        ))}
      </div>

      <h1 class="hero__name layer" id="hero-title" data-z="90">
        <span class="hero__first"><span class="appl"><span class="appl__bg cut-4" aria-hidden="true"></span><Stitch cut={4} light /><span class="appl__l">S</span></span>taša</span>
        <span class="hero__last"><span class="fill-dots">Č</span>imbur</span>
      </h1>
      <p class="hero__role layer" data-z="40">{ui('hero.role')}</p>
      <p class="hero__cities label layer" data-z="40">{ui('hero.cities')}</p>
      <a class="hero__enter label" href="#prolog">
        <svg aria-hidden="true"><use href="#i-manicule" /></svg>{ui('hero.enter')}
      </a>
    </div>
  </div>
  <Thread class="thread--hero" points={[[0.015, 0.25], [0.03, 0.62], [0.06, 0.8], ['.hero__enter', 0.02, 0.95], [0.11, 1.0]]} light />
</section>
