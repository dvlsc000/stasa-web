---
// "Staša Čimbur" written in one running stitch (single-stroke script, see DESIGN.md).
import sig from '../data/signature.json';
interface Props { class?: string; light?: boolean; title?: string }
const { class: cls = '', light = false, title } = Astro.props;
const uid = `s${Math.random().toString(36).slice(2, 8)}`;
---
<svg class:list={['signature', { 'signature--light': light }, cls]} viewBox={`0 0 ${sig.w} ${sig.h}`} role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'} focusable="false">
  <defs><mask id={uid} maskUnits="userSpaceOnUse" x="0" y="0" width={sig.w} height={sig.h}>
    <path class="signature__reveal" d={sig.d} fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
  </mask></defs>
  <path class="signature__line" d={sig.d} mask={`url(#${uid})`} fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
</svg>
