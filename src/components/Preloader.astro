---
import Signature from './Signature.astro';
import Eye from './Eye.astro';
interface Props { skip: string }
const { skip } = Astro.props;
---
<div class="preloader" aria-hidden="true" data-preloader>
  <div class="preloader__sig">
    <Signature />
    <Eye class="preloader__eye" closed />
  </div>
  <button class="preloader__skip label" type="button" tabindex="-1">{skip}</button>
</div>
<script is:inline>
  // show the curtain at most once per session, and never when motion is reduced
  try {
    if (sessionStorage.getItem('seen') || matchMedia('(prefers-reduced-motion: reduce)').matches || location.hash || sessionStorage.getItem('langPos'))
      document.documentElement.classList.add('no-preloader');
  } catch (e) {}
</script>
