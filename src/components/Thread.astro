---
// A length of pale thread for one section. `points` are where it passes:
//   [fx, fy]                 — fractions of the section's width/height
//   [selector, fx, fy]       — fractions of an element inside the section (e.g. under a title)
// The browser turns them into a smooth curve at the real size, then stitches it in as you scroll.
interface Props { points: (number | string)[][]; light?: boolean; class?: string }
const { points, light = false, class: cls = '' } = Astro.props;
---
<svg class:list={['thread', { 'thread--light': light }, cls]} data-thread={JSON.stringify(points)} aria-hidden="true" focusable="false">
  <defs><mask maskUnits="userSpaceOnUse"><path class="thread__reveal" fill="none" stroke="#fff" stroke-width="10" stroke-linecap="round" /></mask></defs>
  <path class="thread__line" fill="none" />
</svg>
