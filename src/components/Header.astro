---
import Eye from './Eye.astro';
import LangSwitch from './LangSwitch.astro';
import { t, type Lang } from '../lib/content';
interface Props { lang: Lang; path?: string; home?: boolean }
const { lang, path = '', home = true } = Astro.props;
const { ui } = t(lang);
const base = home ? '' : `/${lang}/`;
---
<header class="header">
  <a class="header__mark" href={home ? '#top' : `/${lang}/`} aria-label="Staša Čimbur — StashaHats">
    <Eye class="header__eye" /><span>StashaHats</span>
  </a>
  <nav class="header__nav" aria-label={ui('a11y.mainNav')}>
    <a href={`${base}#wearable`}>{ui('nav.wearable')}</a>
    <a href={`${base}#wall`}>{ui('nav.wall')}</a>
    <a href={`${base}#exhibitions`}>{ui('nav.exhibitions')}</a>
    <a href={`${base}#commissions`}>{ui('nav.commissions')}</a>
  </nav>
  <LangSwitch lang={lang} path={path} label={ui('a11y.langSwitch')} class="header__langs" />
  <details class="header__langs-m">
    <summary><span class="sr-only">{ui('a11y.langSwitch')}: </span>{lang.toUpperCase()}</summary>
    <LangSwitch lang={lang} path={path} label={ui('a11y.langSwitch')} />
  </details>
</header>
