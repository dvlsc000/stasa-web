---
import Eye from './Eye.astro';
import Thread from './Thread.astro';
import { t, quote, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { ui } = t(lang);
const q: string = ui('interlude.quote');
const [before, after] = q.split('{eye}');
const parts = quote(lang, '\u0000').split('\u0000');
---
<section class="interlude on-ink" id="interlude" aria-label={ui('interlude.cite')}>
  <figure class="interlude__fig">
    <blockquote class="interlude__quote">
      <p>{parts[0]}{before}<span class="interlude__eye"><Eye closed /></span>{after}{parts[1]}</p>
    </blockquote>
    <figcaption class="label">{ui('interlude.cite')}</figcaption>
  </figure>
  <Thread class="thread--interlude" points={[['.interlude__quote', -0.02, 1.08], ['.interlude__quote', 0.4, 1.13], ['.interlude__quote', 0.75, 1.06], ['.interlude__quote', 1.0, 1.12]]} light />
</section>
