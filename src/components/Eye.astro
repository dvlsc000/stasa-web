---
// The brand eye: a red lashed eye whose lid can blink and whose pupil can look around.
import motifs from '../data/motifs.json';
interface Props { class?: string; closed?: boolean; label?: string }
const { class: cls = '', closed = false, label } = Astro.props;
const uid = `e${Math.random().toString(36).slice(2, 8)}`;
const lashes = [0.12, 0.26, 0.42, 0.58, 0.74, 0.88].map((t) => {
  const [x0, y0, x1, y1, x2, y2, x3, y3] = [6, 30, 24, 8, 76, 8, 94, 30];
  const m = 1 - t;
  const px = m ** 3 * x0 + 3 * m * m * t * x1 + 3 * m * t * t * x2 + t ** 3 * x3;
  const py = m ** 3 * y0 + 3 * m * m * t * y1 + 3 * m * t * t * y2 + t ** 3 * y3;
  const dx = 3 * m * m * (x1 - x0) + 6 * m * t * (x2 - x1) + 3 * t * t * (x3 - x2);
  const dy = 3 * m * m * (y1 - y0) + 6 * m * t * (y2 - y1) + 3 * t * t * (y3 - y2);
  const n = Math.hypot(dx, dy), nx = dy / n, ny = -dx / n, L = t > 0.2 && t < 0.8 ? 14 : 11;
  return `M${px.toFixed(1)},${py.toFixed(1)} q${(nx * L * 0.5 - (dx / n) * 2).toFixed(1)},${(ny * L * 0.5 - (dy / n) * 2).toFixed(1)} ${(nx * L - (dx / n) * 4).toFixed(1)},${(ny * L - (dy / n) * 4).toFixed(1)}`;
}).join(' ');
---
<svg class:list={['eye', { 'is-closed': closed }, cls]} viewBox="-4 -14 108 66" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false">
  <defs><clipPath id={uid}><path d={motifs.EYE_LID} /></clipPath></defs>
  <g clip-path={`url(#${uid})`}>
    <rect x="0" y="0" width="100" height="60" fill="var(--paper)" />
    <g class="eye__pupil">
      <circle cx="50" cy="30" r="14" fill="var(--red)" />
      <circle cx="50" cy="30" r="6.5" fill="var(--ink)" />
      <circle cx="54.5" cy="25.5" r="2.4" fill="var(--paper)" />
    </g>
    <rect class="eye__lid" x="0" y="0" width="100" height="56" fill="var(--red)" />
  </g>
  <g fill="none" stroke="var(--red)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
    <path d={motifs.EYE_LID} />
    <path class="eye__lashes" d={lashes} />
  </g>
</svg>
