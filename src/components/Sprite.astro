---
// Shared SVG defs: fabric patterns for the cut-outs, and the hand-drawn icon set.
import motifs from '../data/motifs.json';
const pats = [
  ['dots-red', 32], ['dots-ink', 32], ['stripes-red', 28], ['wallpaper-ink', 110], ['eyes', 80], ['gingham', 30], ['dots-paper-on-red', 26],
] as const;
---
<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden">
  <defs>
    {pats.map(([id, s]) => (
      <pattern id={`pat-${id}`} patternUnits="userSpaceOnUse" width={s} height={id === 'wallpaper-ink' ? s * 360 / 220 : id === 'eyes' ? s * 0.75 : s}>
        <image href={`/patterns/${id}.svg`} width={s} height={id === 'wallpaper-ink' ? s * 360 / 220 : id === 'eyes' ? s * 0.75 : s} preserveAspectRatio="none" />
      </pattern>
    ))}
    <symbol id="i-manicule" viewBox="-38 -18 76 38">
      <path d={motifs.MANICULE} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-close" viewBox="0 0 40 40">
      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="6 4.2">
        <path d="M7,7 L33,33" /><path d="M33,7 L7,33" />
      </g>
    </symbol>
    <symbol id="i-cross" viewBox="0 0 12 12">
      <path d="M2,2 L10,10 M10,2 L2,10" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round" />
    </symbol>
    <symbol id="i-zoom" viewBox="0 0 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="17" cy="17" r="10" /><path d="M24.5,24.5 L34,34 M13,17 L21,17 M17,13 L17,21" /></g>
    </symbol>
    <symbol id="i-instagram" viewBox="0 0 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M9,8 C16,6 25,6 32,8 C34,15 34,25 32,32 C25,34 15,34 8,32 C6,25 6,15 9,8 Z" /><circle cx="20" cy="20" r="6.5" /><circle cx="28" cy="12" r="1.3" fill="currentColor" /></g>
    </symbol>
  </defs>
</svg>
