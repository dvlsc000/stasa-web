---
import Art from './Art.astro';
import Stitch from './Stitch.astro';
import Flounce from './Flounce.astro';
import { t, wall, plateNo, price, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { ui, work } = t(lang);
const items = wall();
const tilts = ['tilt-c', 'tilt-b', 'tilt-e', 'tilt-a', 'tilt-d'];
---
<section class="salon pat-stripes-red-w" id="wall" aria-labelledby="wall-title">
  <Flounce class="salon__flounce" />
  <div class="salon__pin">
    <div class="salon__wall" data-salon>
      <header class="salon__title cut-1">
        <p class="kicker">{ui('wing2.wing')}</p>
        <h2 id="wall-title">{ui('wing2.title')}</h2>
        <p>{ui('wing2.intro')}</p>
        <Stitch cut={1} />
      </header>
      <ul class="salon__hang" role="list">
        {items.map((w, i) => {
          const wt = work(w.id);
          const p = price(lang, w.price);
          return (
            <li class:list={['frame', `frame--${w.size}`, `frame--${w.frame}`]} data-frame id={`piece-${w.slug}`}>
              <div class:list={['frame__tilt', tilts[i % 5]]}>
                <a class="frame__body" href={`/${lang}/work/${w.slug}/`} data-plate={w.slug} data-cursor="view"
                   aria-label={`${ui('a11y.openPlate')} ${ui('plate')} ${plateNo(w.id)}: ${wt.title}`}>
                  <span class="frame__mat">
                    <Art work={w} alt={wt.alt} mode="photo" plateLabel={ui('plate')} sizes="(max-width: 767px) 80vw, 28vw" />
                  </span>
                  {w.frame === 'stitched' && <Stitch cut={(i % 6) + 1} light />}
                </a>
                <div class:list={['frame__label', 'museum-label', `cut-${((i + 2) % 6) + 1}`]}>
                  <p class="label">{ui('plate')} {plateNo(w.id)} <span class="frame__year">{w.year}</span></p>
                  <p class="museum-label__title">{wt.title}</p>
                  <p class="label frame__avail">
                    <span class:list={['dot', { 'dot--sold': !w.available }]} aria-hidden="true"></span>
                    {w.available ? <>{ui('available')}<span class="frame__price">{p ?? ui('onRequest')}</span></> : ui('sold')}
                  </p>
                  {w.available && <a class="frame__buy label" href={`/${lang}/?enquire=${w.id}#commissions`} data-enquire={w.id}>{ui('enquireBuy')}</a>}
                  <svg class="museum-label__x" aria-hidden="true"><use href="#i-cross" /></svg>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
