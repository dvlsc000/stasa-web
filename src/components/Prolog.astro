---
import Stitch from './Stitch.astro';
import Thread from './Thread.astro';
import Flounce from './Flounce.astro';
import { t, img, site, type Lang } from '../lib/content';
import { SHAPES } from '../data/shapes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { ui } = t(lang);
const portrait = img(site.portrait);
const p1: string = ui('prolog.p1');
const cast: string[] = ui('prolog.cast');
---
<section class="prolog" id="prolog" aria-labelledby="prolog-title">
  <Flounce class="prolog__flounce" />
  <div class="prolog__grid">
    <div class="prolog__panel">
      <div class="prolog__stripes pat-stripes-red-w cut-2"></div>
      <figure class="prolog__portrait">
        <div class="prolog__photo cut-5">
          {portrait ? (
            <picture>
              <source type="image/avif" srcset={portrait.avif} sizes="(max-width: 767px) 80vw, 30vw" />
              <source type="image/webp" srcset={portrait.webp} sizes="(max-width: 767px) 80vw, 30vw" />
              <img src={portrait.fallback} alt={ui('prolog.portraitAlt')} width={portrait.width} height={portrait.height} loading="lazy" decoding="async" />
            </picture>
          ) : (
            <svg class="prolog__ph pat-dots-ink" viewBox="0 0 200 250" role="img" aria-label={ui('prolog.portraitAlt')}>
              <g transform="translate(0 40)">
                {SHAPES.portrait.map(([d, f]) => (
                  <path d={d} fill={f === 'w' ? 'var(--paper)' : f === 'k' ? 'var(--ink)' : 'var(--red)'} />
                ))}
                <path d="M60,166 C70,190 130,190 140,166 L172,210 L28,210 Z" fill="var(--paper)" />
              </g>
            </svg>
          )}
          <Stitch cut={5} light />
        </div>
        <figcaption class="label">Staša Čimbur, Zagreb</figcaption>
      </figure>
      <p class="prolog__count"><span class="num">150+</span><span class="label">{ui('prolog.count')}</span></p>
    </div>

    <div class="prolog__text">
      <p class="kicker">{ui('prolog.kicker')}</p>
      <h2 id="prolog-title" class="prolog__title">{ui('prolog.title')}</h2>
      <p class="prolog__p1"><span class="dropcap" aria-hidden="true">{p1.charAt(0)}</span><span class="sr-only">{p1.charAt(0)}</span>{p1.slice(1)}</p>
      <p>{ui('prolog.p2')}</p>
      <div class="prolog__cast">
        <h3 class="label">{ui('prolog.castTitle')}</h3>
        <ol>
          {cast.map((c, i) => <li><span class="num label">{['I','II','III','IV','V','VI','VII'][i]}</span><span>{c}</span></li>)}
        </ol>
      </div>
    </div>
  </div>
  <Thread class="thread--prolog" points={[[0.11, 0.0], [0.30, 0.06], ['.prolog__title', -0.06, 0.55], ['.prolog__title', 0.12, 1.04], ['.prolog__title', 0.78, 1.0], ['.prolog__title', 1.08, 0.7], [0.97, 0.36], [0.98, 0.7], ['.prolog__cast', 0.6, 1.25], ['.prolog__cast', 0.0, 1.7], [0.49, 1.0]]} />
</section>
