---
// The bare domain sends visitors to their browser language if we have it, otherwise Croatian.
import { LANGS, DEFAULT_LANG } from '../lib/content';
---
<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <title>Staša Čimbur — StashaHats</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`/${DEFAULT_LANG}/`} />
    <meta http-equiv="refresh" content={`0; url=/${DEFAULT_LANG}/`} />
    <script is:inline define:vars={{ LANGS, DEFAULT_LANG }}>
      var pref = (navigator.languages || [navigator.language || '']).map(function (l) { return l.slice(0, 2).toLowerCase(); });
      var hit = pref.find(function (l) { return LANGS.indexOf(l) > -1; });
      location.replace('/' + (hit || DEFAULT_LANG) + '/' + location.search + location.hash);
    </script>
  </head>
  <body style="background:#F3EEE4"><a href={`/${DEFAULT_LANG}/`}>Staša Čimbur</a></body>
</html>
